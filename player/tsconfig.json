{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "w3c-web-serial"],
    "baseUrl": ".",
    "paths": {
      "@ht/*": ["../ht-servo/src/*"],
      "serialport": ["../node_modules/serialport"]
    }
  },
  "include": [".", "../ht-servo/src/types"]
}
