{
  "name": "hitec-showtape",
  "version": "0.1.0",
  "private": true,
  "description": "Show editor that moves Hitec CAN servos in time with a timeline",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:player": "node scripts/build-player.mjs",
    "start": "npm run build:web && npm run build:electron && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p player/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\""
  },
  "license": "ISC",
  "dependencies": {
    "koffi": "3.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serialport": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
